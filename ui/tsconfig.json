{
  "compilerOptions": {
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "downlevelIteration": true,
    "declaration": true,
    "allowJs": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ES2015",
    "target": "ES2015",
    "baseUrl": "./",
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "*": [
        "node_modules/*"
      ],
      "events/*": [
        "src/events/*"
      ],
      "components/*": [
        "src/components/*"
      ],
      "constants/*": [
        "src/constants/*"
      ],
      "hooks/*": [
        "src/hooks/*"
      ],
      "icons/*": [
        "src/icons/*"
      ],
      "messages/*": [
        "src/messages/*"
      ],
      "types/*": [
        "src/types/*"
      ],
      "utils/*": [
        "src/utils/*"
      ],
      "extensionProps/*": [
        "src/types/extensionProps/*"
      ]
    },
    "typeRoots": [
      "node_modules/@types"
    ],
    "outDir": "build/types",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
